# Local caches and Python environments.
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local firmware/memory backups and device readout logs (keep files on disk).
/local-flash-backups/
/flash-*.bin
/sram-*.bin
/system-rom-*.bin
/option-bytes-*.bin
/device-info.txt
/read-log.txt

# Temporary editor files and backup copies.
*.bak
*.tmp
*.swp
*.swo
*~

# Firmware build products and generated material profile include.
/reconstruction/build/
/reconstruction/src/material_profiles.inc
*.o
*.elf
*.hex
*.map
*.su

# Local firmware analysis artifacts.
/reconstruction/analysis/*
!/reconstruction/analysis/README.md
/custom-functionality/analysis/*
!/custom-functionality/analysis/README.md
/reconstruction/decompiled/
/custom-functionality/decompiled/
/reconstruction/ghidra_scripts/
/custom-functionality/ghidra_scripts/
/reconstruction/src/firmware*.S
/custom-functionality/src/firmware*.S

# Local credentials and environment overrides.
.env
.env.*
!.env.example
secrets.yaml
secrets.yml

